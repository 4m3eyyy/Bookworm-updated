@model IEnumerable<Bookworm.Models.Book>
@{
    ViewData["Title"] = "Select Books You've Enjoyed";
    var bookList = Model.ToList();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Select Books You Love</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* Search bar */
        .book-search-wrap {
            max-width: 520px; margin: 0 auto 2rem; position: relative;
        }
        .book-search-input {
            width: 100%; padding: 0.75rem 1rem 0.75rem 3rem;
            background: var(--bg-card); border: 1.5px solid var(--border);
            border-radius: 50px; color: var(--text-primary);
            font-family: 'Outfit', sans-serif; font-size: 1rem;
            transition: border-color 0.25s;
        }
        .book-search-input:focus { outline: none; border-color: var(--accent); }
        .book-search-input::placeholder { color: var(--text-muted); }
        .book-search-icon {
            position: absolute; left: 1.1rem; top: 50%;
            transform: translateY(-50%); font-size: 1rem; color: var(--text-muted);
        }
        .no-results {
            text-align: center; padding: 3rem; color: var(--text-muted);
            font-size: 1rem; display: none;
        }

        /* Book card toggle styles */
        .sel-book-card { position: relative; cursor: pointer; }
        .sel-book-card.picked {
            border-color: var(--accent) !important;
            box-shadow: 0 0 0 2px rgba(79,142,247,0.4);
        }
        .sel-book-card .check-badge {
            position: absolute; top: 8px; right: 8px;
            width: 26px; height: 26px; border-radius: 50%;
            background: var(--accent); display: none;
            align-items: center; justify-content: center;
            font-size: 0.85rem; z-index: 5; color: white; font-weight: 700;
        }
        .sel-book-card.picked .check-badge { display: flex; }

        /* Floating counter */
        .pick-counter {
            position: fixed; bottom: 2rem; right: 2rem; z-index: 100;
            background: rgba(15,24,37,0.95); border: 1px solid var(--border-hover);
            backdrop-filter: blur(16px); border-radius: var(--radius-lg);
            padding: 1.25rem 1.75rem; display: flex; flex-direction: column;
            gap: 0.5rem; align-items: center; box-shadow: var(--shadow-lift);
            min-width: 160px;
        }
        .pick-counter .count { font-size: 2rem; font-weight: 800; color: var(--accent); line-height: 1; }
        .pick-counter .label { font-size: 0.78rem; color: var(--text-muted); margin-bottom: 0.25rem; }

        [data-hidden="true"] { display: none !important; }
    </style>
</head>
<body>

<div style="text-align: center; padding: 2.5rem 4% 1.5rem;">
    <div style="font-size: 3rem; margin-bottom: 0.5rem;">📖</div>
    <h1 style="font-size: 1.8rem; font-weight: 800; margin-bottom: 0.4rem;">Select Books You've Enjoyed</h1>
    <p style="color: var(--text-secondary); max-width: 500px; margin: 0 auto 2rem;">
        Pick at least 3 books — the more you choose, the better your AI recommendations.
    </p>

    <div class="book-search-wrap">
        <span class="book-search-icon">🔍</span>
        <input type="text" id="bookSearch" class="book-search-input"
               placeholder="Search by title or author…" autocomplete="off"
               oninput="filterBooks(this.value)" />
    </div>
</div>

<form method="post" action="/Account/SelectBooks" id="selectForm">
    <div id="hidden-inputs"></div>

    <div class="container">
        <div class="books-grid" id="bookGrid">
            @foreach (var book in bookList)
            {
                <div class="book-card sel-book-card"
                     data-id="@book.BookId"
                     data-title="@book.Title.ToLower()"
                     data-author="@book.Authors.ToLower()"
                     onclick="toggleBook(this, @book.BookId)">
                    <div class="check-badge">✓</div>
                    <div class="book-cover-wrap">
                        <img src="@book.ImageUrl" alt="@book.Title" class="book-cover"
                             onerror="this.src='https://via.placeholder.com/170x255/1a2a3a/4f8ef7?text=📖'" loading="lazy" />
                    </div>
                    <div class="book-info">
                        <div class="book-title">@book.Title</div>
                        <div class="book-author">@book.Authors</div>
                    </div>
                </div>
            }
        </div>
        <div class="no-results" id="noResults">
            <div style="font-size:2.5rem;margin-bottom:0.75rem;">🔍</div>
            No books found for that search. Try a different title or author.
        </div>
    </div>

    <div class="pick-counter">
        <span class="count" id="countDisplay">0</span>
        <span class="label">books selected</span>
        <button type="submit" class="btn-primary" id="finishBtn"
                style="opacity:0.4;pointer-events:none;margin-top:0.25rem;padding:0.6rem 1.5rem;font-size:0.9rem;">
            Finish Setup
        </button>
    </div>
</form>

<div style="padding-bottom: 8rem;"></div>

<script>
    const selected = new Set();
    const hiddenContainer = document.getElementById('hidden-inputs');
    const countDisplay    = document.getElementById('countDisplay');
    const finishBtn       = document.getElementById('finishBtn');
    const noResults       = document.getElementById('noResults');

    function syncHidden() {
        hiddenContainer.innerHTML = '';
        selected.forEach(bid => {
            const inp = document.createElement('input');
            inp.type = 'hidden'; inp.name = 'selectedBooks'; inp.value = bid;
            hiddenContainer.appendChild(inp);
        });
        countDisplay.textContent = selected.size;
        finishBtn.style.opacity       = selected.size >= 3 ? '1'    : '0.4';
        finishBtn.style.pointerEvents = selected.size >= 3 ? 'auto' : 'none';
    }

    function toggleBook(card, id) {
        if (selected.has(id)) { selected.delete(id); card.classList.remove('picked'); }
        else                  { selected.add(id);    card.classList.add('picked'); }
        syncHidden();
    }

    function filterBooks(query) {
        const q = query.trim().toLowerCase();
        const cards = document.querySelectorAll('#bookGrid .sel-book-card');
        let visible = 0;
        cards.forEach(card => {
            const match = !q || card.dataset.title.includes(q) || card.dataset.author.includes(q);
            card.setAttribute('data-hidden', match ? 'false' : 'true');
            if (match) visible++;
        });
        noResults.style.display = (visible === 0 && q) ? 'block' : 'none';
    }
</script>
</body>
</html>
