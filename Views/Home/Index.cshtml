        }
    </div>
    <button class="strip-btn right" onclick="this.closest('.strip-wrapper').querySelector('.strip').scrollBy({left:600,behavior:'smooth'})">›</button>
</div>

@* ── GENRE SPOTLIGHTS ── *@
@foreach (var spotlight in Model.GenreSpotlights)
{
    <div class="strip-wrapper">
        <div class="section-header">
            <h2 class="section-title">
                <span class="icon">@(genreIcons.GetValueOrDefault(spotlight.Key, "📚"))</span>
                @spotlight.Key
            </h2>
            <a href="@Url.Action("Browse","Books", new { genre = spotlight.Key })" class="section-link">Browse @spotlight.Key →</a>
        </div>
        <button class="strip-btn left" onclick="this.closest('.strip-wrapper').querySelector('.strip').scrollBy({left:-600,behavior:'smooth'})">‹</button>
        <div class="strip">
            @foreach (var book in spotlight.Value)
            {
                <a href="@Url.Action("Details","Books", new { id = book.BookId })" class="book-card">
                    <div class="book-cover-wrap">
                        <img src="@book.ImageUrl" alt="@book.Title" class="book-cover"
                             onerror="this.src='https://via.placeholder.com/160x240/1a2a3a/4f8ef7?text=📖'" loading="lazy" />
                        <div class="book-card-overlay"><span class="rating">★ @book.AverageRating</span></div>
                    </div>
                    <div class="book-info">
                        <div class="book-title">@book.Title</div>
                        <div class="book-author">@book.Authors</div>
                    </div>
                </a>
            }
        </div>
        <button class="strip-btn right" onclick="this.closest('.strip-wrapper').querySelector('.strip').scrollBy({left:600,behavior:'smooth'})">›</button>
    </div>
}

@* ── BROWSE BY GENRE CARDS ── *@
<div class="genres-section">
    <div class="section-header" style="padding: 0;">
        <h2 class="section-title"><span class="icon">🏷️</span> Browse by Genre</h2>
        <a href="@Url.Action("Browse","Books")" class="section-link">All books →</a>
    </div>
    <div class="genres-grid">
        @foreach (var genre in Model.AllGenres)
        {
            var cssClass = genreClasses.GetValueOrDefault(genre, "genre-general");
            var icon = genreIcons.GetValueOrDefault(genre, "📚");
            <a href="@Url.Action("Browse","Books", new { genre = genre })" class="genre-card @cssClass">
                <span class="genre-icon">@icon</span>
                @genre
            </a>
        }
    </div>
</div>
